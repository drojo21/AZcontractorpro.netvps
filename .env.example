# AZ Contractor Pro platform — copy to .env and fill in.
# deploy/install.sh writes this file for you with fresh secrets.

# ---- where it runs -----------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Database, contractor sites, photos and backups all live here. Back it up.
DATA_DIR=/var/lib/acp
# Behind Caddy, so trust X-Forwarded-For / -Proto.
TRUST_PROXY=true

# ---- hostnames ---------------------------------------------------------------
# The admin (website creator + CRM), contractor portal and API.
APP_URL=https://app.azcontractorpro.net
# Your own sales site (served from public/sales). Comma-separated. Leave empty to
# serve it only at <APP_URL>/sales/.
SALES_HOSTS=azcontractorpro.net,www.azcontractorpro.net
# Every contractor site gets <slug>.<SITES_DOMAIN> automatically. Point a wildcard
# DNS record (*.azcontractorpro.net) at this VPS. Leave empty to skip subdomains
# and use custom domains only.
SITES_DOMAIN=azcontractorpro.net
# Shown to contractors in "point your domain here" instructions.
PUBLIC_IP=

# ---- first admin -------------------------------------------------------------
# Created on first start if there are no users yet. Remove the password after.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Signs contractor portal tokens and demo links. openssl rand -hex 32
SESSION_SECRET=change-me
# Optional key for scripts: Authorization: Bearer <API_KEY> on /api/admin/*
API_KEY=

# ---- email -------------------------------------------------------------------
# Any SMTP relay (Postmark, SES, Mailgun, Fastmail, a Gmail app password).
# Leave SMTP_HOST empty and mail is only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AZ Contractor Pro <leads@azcontractorpro.net>"

# ---- Stripe (your own billing) -------------------------------------------------
# Prices are found by lookup key acp_<tier>_setup / acp_<tier>_monthly — the
# same keys already created in your Stripe account. See docs/BILLING.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Days between paying the setup fee and the first monthly charge.
MONTHLY_START_DELAY_DAYS=14
STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/28EaEX2E97Yj8dV2OqdZ600

# ---- optional: AI copy -------------------------------------------------------
# Lets the website creator rewrite headline/about copy with Claude. Every call is
# logged against the contractor with its token cost. Leave empty to turn off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- limits ------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PHOTOS_PER_SITE=300
RELEASES_TO_KEEP=5

# ---- docker compose only -----------------------------------------------------
# Caddy in docker-compose.yml reads these; deploy/install.sh does not need them.
APP_HOST=app.azcontractorpro.net
CADDY_SALES_HOSTS=azcontractorpro.net www.azcontractorpro.net
ACME_EMAIL=you@example.com
