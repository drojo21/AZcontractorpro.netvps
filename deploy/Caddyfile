# Caddy in front of AZ Contractor Pro: HTTPS for everything, automatically.
#
# deploy/install.sh renders this into /etc/caddy/Caddyfile with your hostnames.
# docker-compose.yml passes the same values as environment variables, so this
# one file serves both paths.
#
#   APP_HOST           app.azcontractorpro.net          admin, portal, API
#   CADDY_SALES_HOSTS  azcontractorpro.net, www.azcontractorpro.net
#   ACME_EMAIL         where Let's Encrypt sends expiry warnings
#   ACP_UPSTREAM       127.0.0.1:8787 (systemd) or app:8787 (compose)
{
	email {$ACME_EMAIL}
	# Contractor sites get their certificate on the first visit. Caddy asks the
	# app first, and the app says yes only for <slug>.SITES_DOMAIN of a real site
	# or a domain attached to one — so nobody can make this box request
	# certificates for names it does not serve.
	on_demand_tls {
		ask http://{$ACP_UPSTREAM:127.0.0.1:8787}/_acp/tls-ask
	}
}

(acp) {
	encode zstd gzip
	request_body {
		max_size 40MB
	}
	reverse_proxy {$ACP_UPSTREAM:127.0.0.1:8787}
	header -Server
	log {
		output file /var/log/caddy/acp.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Admin, portal, API and your own sales site: certificates issued at start-up.
{$APP_HOST} {$CADDY_SALES_HOSTS} {
	import acp
}

# Every contractor site: <slug>.<SITES_DOMAIN> and any custom domain pointed here.
https:// {
	tls {
		on_demand
	}
	import acp
}

# Plain HTTP: answer domain verification directly (a custom domain has no
# certificate until its DNS points here), redirect everything else.
http:// {
	handle /_acp/whoami {
		reverse_proxy {$ACP_UPSTREAM:127.0.0.1:8787}
	}
	handle {
		redir https://{host}{uri} 308
	}
}
